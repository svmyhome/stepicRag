{
  "uid": "local-llm",
  "title": "Local LLM",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Изменение RSS после загрузки модели",
      "description": "Приблизительная разница RSS процесса до и после загрузки, обновляется при загрузке модели.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "llm_ram_usage_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Успешные генерации в минуту",
      "description": "Только пользовательские запросы.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_inference_latency_seconds_count{kind=\"user\"}[5m]) * 60",
          "legendFormat": "генераций/мин",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Среднее время успешной генерации",
      "description": "Только успешные пользовательские запросы; включает ожидание очереди.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_inference_latency_seconds_sum{kind=\"user\"}[5m]) / rate(llm_inference_latency_seconds_count{kind=\"user\"}[5m])",
          "legendFormat": "среднее",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Доступность сбора метрик",
      "description": "1 — Prometheus получает метрики; 0 — получить метрики не удалось. Это не проверка inference.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"local_llm\"}",
          "legendFormat": "сбор метрик",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ошибки inference за 5 минут",
      "description": "Ошибки при выполнении модели; таймауты проверки здоровья показаны отдельно.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(llm_inference_errors_total{kind=\"user\"}[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Запросы в очереди и работе",
      "description": "Текущее состояние пользовательских запросов.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "llm_queued_requests{kind=\"user\"}",
          "refId": "A",
          "legendFormat": "очередь"
        },
        {
          "expr": "llm_active_requests{kind=\"user\"}",
          "refId": "B",
          "legendFormat": "выполняются"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Среднее ожидание очереди",
      "description": "Среднее время ожидания за 5 минут.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_queue_wait_seconds_sum{kind=\"user\"}[5m]) / rate(llm_queue_wait_seconds_count{kind=\"user\"}[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Среднее время работы модели",
      "description": "Только успешные пользовательские генерации, без очереди.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_execution_seconds_sum{kind=\"user\"}[5m]) / rate(llm_execution_seconds_count{kind=\"user\"}[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Время ответа: p50, p95, p99",
      "description": "Приблизительные перцентили за 5 минут; для редких запросов оценка нестабильна.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_inference_latency_seconds_bucket{kind=\"user\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_inference_latency_seconds_bucket{kind=\"user\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_inference_latency_seconds_bucket{kind=\"user\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Токены в минуту",
      "description": "Число токенов из usage ответа модели; показаны только успешные запросы.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_tokens_total{kind=\"user\",direction=\"input\"}[5m]) * 60",
          "refId": "A",
          "legendFormat": "входные"
        },
        {
          "expr": "rate(llm_tokens_total{kind=\"user\",direction=\"output\"}[5m]) * 60",
          "refId": "B",
          "legendFormat": "выходные"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Скорость генерации, токенов/с",
      "description": "Средняя скорость успешных генераций за 5 минут, без ожидания очереди.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_tokens_total{kind=\"user\",direction=\"output\"}[5m]) / rate(llm_execution_seconds_sum{kind=\"user\"}[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "RSS всего процесса",
      "description": "Текущая физическая память процесса, не только модели.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "llm_process_rss_bytes",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU процесса",
      "description": "100% соответствует одному полностью занятому ядру; значение может превышать 100%.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(llm_process_cpu_seconds_total[5m]) * 100",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Последний healthcheck",
      "description": "1 — успех, 0 — ошибка или таймаут; до первой проверки значение 0 не означает отказ.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "llm_healthcheck_success",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Результаты healthcheck за 5 минут",
      "description": "Проверки выполняются только при обращении к /health.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(llm_healthcheck_total[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Восстановления за 5 минут",
      "description": "Успешные и завершившиеся ошибкой попытки восстановления.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(llm_recovery_total[5m])",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
